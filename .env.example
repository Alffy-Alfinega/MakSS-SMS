# Copy to `.env` and fill in. Never commit `.env` (gitignored via `.env*`).
# Target: standard PostgreSQL over the plain wire protocol — no vendor lock-in.
# Works against the local dev cluster today, any Postgres tomorrow.

# Direct (unpooled) connection — app runtime AND Prisma migrations.
DATABASE_URL="postgresql://makss:makss_local_dev@127.0.0.1:5432/makss_sms?schema=public"

# Auth (Better Auth). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="change-me-64-hex-chars"
BETTER_AUTH_URL="http://localhost:3000"

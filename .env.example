# Copy to `.env` and fill in. Never commit `.env` (gitignored via `.env*`).
# Target: Neon PostgreSQL over the standard wire protocol — no vendor lock-in.

# Pooled endpoint (pgbouncer) — app runtime. Go through the pooler so the
# app scales past the direct connection limit.
#
# `sslmode=verify-full` verifies the server certificate. `require` currently
# behaves the same in pg-connection-string v2, but pg v9 adopts libpq
# semantics where `require` does NOT verify the host — so be explicit.
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full"

# Direct endpoint (no pgbouncer) — Prisma migrations and the CLI. DDL and
# schema shadow operations need a real session, which the pooler cannot give.
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Auth (Better Auth). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="change-me-64-hex-chars"
# Must match the origin the app is served from. Better Auth rejects requests
# from other origins with INVALID_ORIGIN.
BETTER_AUTH_URL="http://localhost:3000"
